PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=amc_asterix

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Set your PC LAN IP so other devices can open https://LAN_IP:5173
# Leave empty to keep localhost-only CLIENT_URL / announced IP.
LAN_IP=
# Exact URL in the browser (localhost, LAN, or public domain)
CLIENT_URL=http://localhost:5173
PUBLIC_URL=
# Extra allowed origins, comma-separated (e.g. https://team.asterixmc.com)
CORS_ORIGINS=
UPLOAD_DIR=uploads

# Video provider: jitsi (recommended) or webrtc (mediasoup)
VIDEO_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.asterixmc.com

# Private WebRTC (mediasoup SFU + STUN/TURN) — used only when VIDEO_PROVIDER=webrtc
WEBRTC_LISTEN_IP=0.0.0.0
WEBRTC_ANNOUNCED_IP=
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated TURN URLs. Use TURN_SECRET for coturn, or TURN_USERNAME/TURN_PASSWORD for Metered.
TURN_URL=
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
